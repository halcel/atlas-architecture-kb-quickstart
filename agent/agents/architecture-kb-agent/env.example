# Atlas cluster that holds the knowledge base (Flex or M10+ in the project linked to Agent Engine).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=knowledge_base
EMBED_MODEL=voyage-4

LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
# Optional: Anthropic-compatible gateway. Also add its host to the tool sandbox egress in agent.yaml.
LLM_BASE_URL=
LLM_AUTH_HEADER=x-api-key

# Only for ingest/load.py --confluence-page. Cloud: email + API token. Data Center: CONFLUENCE_PAT.
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_PAT=
